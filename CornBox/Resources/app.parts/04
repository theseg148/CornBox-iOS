function toastMsg(msg){toast.textContent=msg;toast.classList.add('show');clearTimeout(toastMsg.t);toastMsg.t=setTimeout(()=>toast.classList.remove('show'),1700)}
function logActivity(type,title,detail=''){
  const icons={like:'♥',comment:'◌',import:'＋',view:'▶',album:'▤',profile:'◉',account:'@',remove:'−',shuffle:'⤨',settings:'⚙'};
  activity.unshift({type,title,detail,time:Date.now(),icon:icons[type]||'•'});
  activity=activity.slice(0,100);
  if($('activityScreen').classList.contains('open')) renderActivity();
}
function timeAgo(ts){
  const s=Math.max(1,Math.floor((Date.now()-ts)/1000));
  if(s<60)return s+'s ago';
  const m=Math.floor(s/60); if(m<60)return m+'m ago';
  const h=Math.floor(m/60); if(h<24)return h+'h ago';
  return Math.floor(h/24)+'d ago';
}
function renderActivity(){
  const box=$('activityList');
  if(!activity.length){
    box.innerHTML='<div class="activity-empty"><div class="big">◴</div><h3>No activity yet</h3><div>Likes, comments, imports, views and album changes will appear here.</div></div>';
    return;
  }
  box.innerHTML=activity.map(a=>`<div class="activity-item"><div class="activity-ico">${esc(a.icon)}</div><div class="activity-copy"><b>${esc(a.title)}</b>${a.detail?`<span>${esc(a.detail)}</span>`:''}<span>${timeAgo(a.time)}</span></div></div>`).join('');
}

function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
