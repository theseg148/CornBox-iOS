  slide.appendChild(box);
  box.querySelector('#stuckRetry').addEventListener('click', (e) => {
    e.stopPropagation();
    box.remove();
    unloadMedia(media);
    loadMedia(media);
    toggleSpinner(slide, true);
  });
}

function scheduleAutoscroll(slide, media) {
  clearTimeout(autoscrollTimer);
  if (!settings.enabled) return;

  if (media.tagName === 'VIDEO') {
    if (settings.videoMode === 'fixed') {
      autoscrollTimer = setTimeout(() => advance(slide), settings.videoDelay * 1000);
      return;
    }
    // wait for the video to finish, optionally capped for very long videos
    const useDuration = () => {
      let delay = (media.duration || settings.videoDelay) * 1000;
      if (settings.capDelay > 0) delay = Math.min(delay, settings.capDelay * 1000);
      autoscrollTimer = setTimeout(() => advance(slide), delay);
    };
    if (media.readyState >= 1) useDuration(); else media.addEventListener('loadedmetadata', useDuration, { once:true });
  } else {
    autoscrollTimer = setTimeout(() => advance(slide), settings.photoDelay * 1000);
  }
}
function advance(slide) {
  const next = slide.nextElementSibling;
  if (next) { next.scrollIntoView({ behavior:'smooth' }); return; }
  if (settings.loop) {
    const first = feedEl.firstElementChild;
    if (first) first.scrollIntoView({ behavior:'smooth' });
  }
}

