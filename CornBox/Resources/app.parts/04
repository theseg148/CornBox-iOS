 if(item){
  const m=document.createElement(item.type==='video'?'video':'img');m.className='media';m.src=item.url;
  if(item.type==='video'){m.playsInline=true;m.preload='metadata';m.muted=defaultMuted;m.addEventListener('click',()=>m.paused?m.play():m.pause())}
  slide.appendChild(m);
 }else slide.innerHTML='<div class="placeholder"><div class="placeholder-inner"><div class="placeholder-logo">🌽</div><div class="placeholder-title">CornBox</div><div class="placeholder-sub">Add videos or photos to start your feed.</div></div></div>';
 const key=itemKey(item),isLiked=item&&liked[key],count=(comments[key]||[]).length;
