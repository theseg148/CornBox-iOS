// Native import progress HUD. The Swift wrapper reports progress while copying large
// batches so importing 30-50 videos doesn't feel like the app froze.
window.cornboxNativeImportProgress = function(completed, total, finished) {
  if (!IS_NATIVE_IOS || !total) return;
  let hud = document.getElementById('nativeImportHUD');
  if (!hud) {
    hud = document.createElement('div');
    hud.id = 'nativeImportHUD';
    hud.style.cssText = 'position:fixed;left:50%;bottom:calc(env(safe-area-inset-bottom) + 82px);transform:translateX(-50%);z-index:200;width:min(86vw,360px);padding:12px 14px;border-radius:18px;background:rgba(18,18,18,.88);border:1px solid rgba(255,255,255,.10);box-shadow:0 8px 30px rgba(0,0,0,.45);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);font-family:-apple-system,BlinkMacSystemFont,sans-serif;color:white;';
    hud.innerHTML = '<div id="nativeImportText" style="font-size:13px;font-weight:700;margin-bottom:8px;"></div><div style="height:5px;border-radius:999px;background:rgba(255,255,255,.13);overflow:hidden;"><div id="nativeImportBar" style="height:100%;width:0%;background:#ff7a1a;border-radius:inherit;transition:width .18s ease;"></div></div>';
    document.body.appendChild(hud);
  }
  const pct = Math.max(0, Math.min(100, Math.round((completed / total) * 100)));
  const text = hud.querySelector('#nativeImportText');
  const bar = hud.querySelector('#nativeImportBar');
  text.textContent = finished ? `Imported ${total} item${total === 1 ? '' : 's'}` : `Importing ${completed} of ${total}…`;
  bar.style.width = pct + '%';
  hud.style.display = 'block';
  clearTimeout(window.__cornboxImportHideTimer);
  if (finished) {
    window.__cornboxImportHideTimer = setTimeout(() => {
      hud.style.opacity = '0';
      hud.style.transition = 'opacity .25s ease';
      setTimeout(() => hud.remove(), 280);
    }, 900);
  }
};

