function filteredItems(){
 let arr=[...items],q=librarySearch.value.trim().toLowerCase();
 if(currentFilter==='liked')arr=arr.filter(x=>liked[itemKey(x)]);
 if(currentFilter==='photos')arr=arr.filter(x=>x.type==='image');
 if(currentFilter==='videos')arr=arr.filter(x=>x.type==='video');
 if(currentFilter==='history')arr=history.map(k=>items.find(x=>itemKey(x)===k)).filter(Boolean);
 if(q)arr=arr.filter(x=>x.name.toLowerCase().includes(q));
 if(sortMode==='name')arr.sort((a,b)=>a.name.localeCompare(b.name));
 if(sortMode==='type')arr.sort((a,b)=>a.type.localeCompare(b.type)||a.name.localeCompare(b.name));
 return arr;
}
