      const rect = track.getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
      if (media.duration) media.currentTime = ratio * media.duration;
      fill.style.width = (ratio*100) + '%';
      dot.style.left = (ratio*100) + '%';
    };

    let dragging = false;
    progress.addEventListener('click', (e) => { e.stopPropagation(); seekTo(e.clientX); });
    progress.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
      dragging = true;
      progress.classList.add('dragging');
      media.pause();
      seekTo(e.clientX);
      progress.setPointerCapture(e.pointerId);
    });
    progress.addEventListener('pointermove', (e) => { if (dragging) seekTo(e.clientX); });
    progress.addEventListener('pointerup', () => { dragging = false; progress.classList.remove('dragging'); media.play().catch(()=>{}); });
    progress.addEventListener('pointercancel', () => { dragging = false; progress.classList.remove('dragging'); });

    media.addEventListener('error', () => showMediaError(slide, item, media));
    media.addEventListener('waiting', () => toggleSpinner(slide, true));
    media.addEventListener('playing', () => { toggleSpinner(slide, false); clearStallWatch(slide); });
    media.addEventListener('canplay', () => { toggleSpinner(slide, false); clearStallWatch(slide); });
  }

  const heart = document.createElement('div');
  heart.className = 'heart-burst';
  heart.textContent = '❤️';
  slide.appendChild(heart);

  const meta = document.createElement('div');
  meta.className = 'meta';
  const cCount = (comments[item.name] || []).length;
  meta.innerHTML = `<div class="name">${escapeHtml(item.name)}</div>
    ${cCount ? `<div class="cmt-preview">💬 ${cCount} comment${cCount>1?'s':''}</div>` : ''}`;
  slide.appendChild(meta);

  const actions = document.createElement('div');
  actions.className = 'actions';

  const likeBtn = document.createElement('button');
  likeBtn.className = 'action-btn';
  const liked = () => !!likes[item.name];
  likeBtn.classList.toggle('liked', liked());
  likeBtn.innerHTML = `❤️<span>${liked() ? 'Liked' : 'Like'}</span>`;
  likeBtn.addEventListener('click', (e) => { e.stopPropagation(); toggleLike(item.name); likeBtn.classList.toggle('liked', liked()); likeBtn.querySelector('span').textContent = liked() ? 'Liked' : 'Like'; });
  actions.appendChild(likeBtn);

  const cmtBtn = document.createElement('button');
  cmtBtn.className = 'action-btn';
  cmtBtn.innerHTML = `💬<span>${cCount || 'Comment'}</span>`;
  cmtBtn.addEventListener('click', (e) => { e.stopPropagation(); openComments(item.name); });
  actions.appendChild(cmtBtn);

  const albumBtn = document.createElement('button');
  albumBtn.className = 'action-btn';
  albumBtn.innerHTML = `📁<span>Album</span>`;
  albumBtn.addEventListener('click', (e) => { e.stopPropagation(); openAlbumPicker(item.name); });
  actions.appendChild(albumBtn);

  if (item.type === 'video') {
    const muteBtn = document.createElement('button');
    muteBtn.className = 'action-btn' + (muted ? ' muted-off' : '');
    muteBtn.innerHTML = `${muted ? '🔇' : '🔊'}<span>Sound</span>`;
    muteBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      muted = !muted;
      document.querySelectorAll('video').forEach(v => v.muted = muted);
      muteBtn.classList.toggle('muted-off', muted);
      muteBtn.innerHTML = `${muted ? '🔇' : '🔊'}<span>Sound</span>`;
    });
    actions.appendChild(muteBtn);
  }

  slide.appendChild(actions);
  return slide;
}

function toggleLike(name, forceOn) {
  if (forceOn) likes[name] = true;
  else likes[name] = !likes[name];
  saveLikes();
}

function burstHeart(slide) {
  const h = slide.querySelector('.heart-burst');
  h.classList.remove('play'); void h.offsetWidth; h.classList.add('play');
}

function loadMedia(m) {
  if (!m || m.dataset.src === undefined) return;
  if (m.tagName === 'VIDEO') {
    if (!m.getAttribute('src')) { m.preload = 'auto'; m.src = m.dataset.src; }
  } else if (!m.getAttribute('src')) {
    m.src = m.dataset.src;
  }
}
function unloadMedia(m) {
  if (!m) return;
  if (m.tagName === 'VIDEO' && m.getAttribute('src')) {
    m.pause();
    m.removeAttribute('src');
    m.load(); // actually releases the buffered data / stops any in-flight request
  } else if (m.tagName === 'IMG' && m.getAttribute('src')) {
    m.removeAttribute('src');
  }
}
// keeps only the current slide's media (+ neighbors on larger/desktop screens) loaded,
// so the feed isn't fighting itself for bandwidth loading every video at once.
// Phones generally only have 1-2 hardware video decoder slots — keeping extra videos
// "loaded" there doesn't make scrolling smoother, it makes them stall waiting for a
// decoder slot that's busy. So on mobile we keep only the one actually on screen.
const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || (navigator.maxTouchPoints > 1 && matchMedia('(pointer:coarse)').matches);
const KEEP_RADIUS = isMobile ? 0 : 1;
const UNLOAD_DELAY = isMobile ? 0 : 400; // no debounce needed on mobile — we want the old video gone immediately, not lingering and holding a decoder slot

let unloadDebounce = null;
function manageLoading(activeSlide) {
  const slides = Array.from(feedEl.children);
  const idx = slides.indexOf(activeSlide);
  slides.forEach((s, i) => { if (Math.abs(i - idx) <= KEEP_RADIUS) loadMedia(s.querySelector('video, img')); });
  clearTimeout(unloadDebounce);
  const doUnload = () => slides.forEach((s, i) => { if (Math.abs(i - idx) > KEEP_RADIUS) unloadMedia(s.querySelector('video, img')); });
  if (UNLOAD_DELAY === 0) doUnload();
  else unloadDebounce = setTimeout(doUnload, UNLOAD_DELAY);
}

function setupObserver() {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const media = entry.target.querySelector('video, img');
      if (entry.isIntersecting) {
        currentSlide = entry.target;
        manageLoading(entry.target);
        if (media.tagName === 'VIDEO') {
          media.currentTime = 0; media.muted = muted;
          const playNow = () => media.play().catch(()=>{});
          if (media.readyState >= 3) playNow(); else media.addEventListener('canplay', playNow, { once: true });
          toggleSpinner(entry.target, media.readyState < 3);
        }
        scheduleAutoscroll(entry.target, media);
      } else if (media.tagName === 'VIDEO') { media.pause(); }
    });
  }, { threshold: 0.6 });
  document.querySelectorAll('.slide').forEach(s => observer.observe(s));
}

function toggleSpinner(slide, show) {
  const sp = slide.querySelector('.buffer-spinner');
  if (sp) sp.style.display = show ? 'block' : 'none';
  if (show) startStallWatch(slide); else clearStallWatch(slide);
}

const stallTimers = new WeakMap();
function startStallWatch(slide) {
  if (stallTimers.has(slide)) return; // already watching
  const timer = setTimeout(() => {
    const media = slide.querySelector('video');
    if (!media) return;
    toggleSpinner(slide, false);
    showStuckMessage(slide, media);
  }, 7000);
  stallTimers.set(slide, timer);
}
function clearStallWatch(slide) {
  const timer = stallTimers.get(slide);
  if (timer) { clearTimeout(timer); stallTimers.delete(slide); }
  const stuck = slide.querySelector('.media-stuck');
  if (stuck) stuck.remove();
}
function showStuckMessage(slide, media) {
  if (slide.querySelector('.media-stuck') || slide.querySelector('.media-error')) return;
  const box = document.createElement('div');
  box.className = 'media-error media-stuck';
  box.innerHTML = `<div class="media-error-icon">⏳</div>
    <div class="media-error-title">Still loading after 7 seconds</div>
    <div class="media-error-msg">This usually means a slow/unstable connection, or a format your browser can't stream well. </div>
    <button class="btn secondary" id="stuckRetry" style="margin-top:10px;">Retry</button>`;
