.chev{font-size:19px;color:#555}
.sheet-wrap{
  position:fixed;z-index:100;inset:0;
  display:none;align-items:flex-end;
  background:rgba(0,0,0,.58)
}
.sheet-wrap.open{display:flex}
.sheet{
  width:100%;
  max-height:84dvh;
  background:#141414;
  border-radius:22px 22px 0 0;
  padding-bottom:calc(14px + env(safe-area-inset-bottom));
  overflow-y:auto
}
.sheet-handle{
  width:38px;height:5px;border-radius:999px;
  background:#3a3a3a;margin:9px auto
}
.sheet-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:8px 16px 14px
}
.sheet-head h3{margin:0;font-size:18px}
.sheet-content{padding:0 16px}
.sheet-row{
  padding:15px 0;
  border-bottom:1px solid var(--line);
  display:flex;align-items:center;justify-content:space-between;
  gap:14px
}
.sheet-row:last-child{border-bottom:0}
.sheet-row b{display:block;font-size:14px}
.sheet-row small{display:block;color:var(--muted);font-size:12px;margin-top:2px}
.switch{
  width:48px;height:28px;border-radius:999px;
  background:#333;position:relative;flex:0 0 auto
}
.switch:after{
  content:"";position:absolute;
  width:22px;height:22px;border-radius:50%;
  background:#fff;left:3px;top:3px;transition:.18s
}
.switch.on{background:var(--accent)}
.switch.on:after{transform:translateX(20px)}
.field{
  width:100%;margin-top:8px;
  background:#222;border:1px solid #333;
  color:#fff;border-radius:10px;padding:12px
}
#importInput,#profileInput{display:none}
.toast{
  position:fixed;z-index:200;
  left:50%;bottom:calc(88px + env(safe-area-inset-bottom));
  transform:translateX(-50%) translateY(18px);
  background:rgba(28,28,28,.96);
  border:1px solid rgba(255,255,255,.1);
  padding:10px 14px;border-radius:999px;
  font-size:12px;font-weight:700;
  opacity:0;pointer-events:none;transition:.2s;
  white-space:nowrap
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
@media(min-width:700px){
  #app{max-width:430px;left:50%;transform:translateX(-50%);box-shadow:0 0 0 1px #222}
  .topbar,.bottom-nav,.screen{left:50%;right:auto;width:430px;transform:translateX(-50%)}
  .sheet-wrap{justify-content:center}.sheet{max-width:430px}
}

