t.toggle('on',v);restartAuto()}
autoBtn.onclick=()=>setAuto(!auto);autoSwitch.onclick=()=>setAuto(!auto);
loopSwitch.onclick=()=>{loop=!loop;loopSwitch.classList.toggle('on',loop)};
muteSwitch.onclick=()=>{defaultMuted=!defaultMuted;muteSwitch.classList.toggle('on',defaultMuted);feed.querySelectorAll('video').forEach(v=>v.muted=defaultMuted)};
autoplaySwitch.onclick=()=>{autoplay=!autoplay;autoplaySwitch.classList.toggle('on',autoplay)};
photoRange.oninput=()=>photoVal.textContent=photoRange.value+' seconds';
function restartAuto(){clearTimeout(autoTimer);if(!auto)return;autoTimer=setTimeout(()=>{const slides=[...feed.children],idx=Math.round(feed.scrollTop/Math.max(1,feed.clientHeight));if(idx<slides.length-1)slides[idx+1].scrollIntoView({behavior:'smooth'});else if(loop)slides[0]?.scrollIntoView({behavior:'smooth'});restartAuto()},+photoRange.value*1000)}
let viewTimer;
feed.addEventListener('scroll',()=>{clearTimeout(viewTimer);viewTimer=setTimeout(()=>{if(!items.length)return;const idx=Math.round(feed.scrollTop/Math.max(1,feed.clientHeight)),it=items[idx];if(!it)return;const key=itemKey(it);if(history[0]!==key)logActivity('view','Viewed media',it.name);history=[key,...history.filter(x=>x!==key)].slice(0,50);if(autoplay){feed.querySelectorAll('video').forEach((v,i)=>{if(i===idx)v.play().catch(()=>{});else v.pause()})}if(auto){clearTimeout(autoTimer);autoTimer=setTimeout(restartAuto,400)}},150)});
function openSheet(id){$(id).classList.add('open')}function closeSheets(){document.querySelectorAll('.sheet-wrap').forEach(x=>x.classList.remove('open'))}
document.addEventListener('click',e=>{if(e.target.classList.contains('close-sheet'))closeSheets();if(e.target.classList.contains('sheet-wrap'))closeSheets()});
function openComments(it){currentItem=it;renderComments();openSheet('commentsSheet');setTimeout(()=>$('commentInput').focus(),100)}
function renderComments(){const key=itemKey(currentItem),list=comments[key]||[];$('commentList').innerHTML=list.length?list.map(c=>`<div class="comment"><b>${esc(profile.name||'You')}</b>${esc(c)}</div>`).join(''):'<div class="empty" style="padding:30px 10px">No comments yet.</div>'}
$('commentSend').onclick=()=>{const v=$('commentInput').value.trim();if(!v||!currentItem)return;const key=itemKey(currentItem);(comments[key]??=[]).push(v);logActivity('comment','Commented on media',currentItem.name);$('commentInput').value='';renderComments();renderFeed()};
$('commentInput').addEventListener('keydown',e=>{if(e.key==='Enter')$('commentSend').click()});
$('addToAlbumBtn').onclick=()=>{renderAlbumChoices();closeSheets();openSheet('albumSheet')};
$('toggleLikeMoreBtn').onclick=()=>{if(!currentItem)return;const k=itemKey(currentItem);liked[k]=!liked[k];logActivity('like',liked[k]?'Liked media':'Unliked media',currentItem.name);closeSheets();renderFeed();renderLibrary();updateStats();toastMsg(liked[k]?'Liked':'Unliked')};
$('deleteMediaBtn').onclick=()=>{if(!currentItem)return;const k=itemKey(currentItem);items=items.filter(x=>x!==currentItem);Object.keys(albums).forEach(a=>albums[a]=albums[a].filter(x=>x!==k));logActivity('remove','Removed media from session',currentItem.name);currentItem=null;closeSheets();renderFeed();renderLibrary();updateStats();toastMsg('Removed from session')};
function renderAlbumChoices(){const box=$('albumChoices'),names=Object.keys(albums);box.innerHTML=names.map(n=>`<button class="album-choice" data-album="${esc(n)}">${esc(n)} <span style="float:right;color:var(--muted)">${albums[n].length}</span></button>`).join('')||'<div style="color:var(--muted);padding:8px 0">No albums yet.</div>';box.querySelectorAll('[data-album]').forEach(b=>b.onclick=()=>{const n=b.dataset.album,k=itemKey(currentItem);if(!albums[n].includes(k))albums[n].push(k);logActivity('album','Added media to album',n);closeSheets();updateStats();toastMsg('Added to '+n)})}
$('createAlbumBtn').onclick=()=>{const n=$('albumNameInput').value.trim();if(!n||!currentItem)return;albums[n]??=[];const k=itemKey(currentItem);if(!albums[n].includes(k))albums[n].push(k);$('albumNameInput').value='';logActivity('album','Created album',n);closeSheets();updateStats();toastMsg('Album created')};
$('settingsBtn').onclick=()=>openSheet('settingsSheet');$('editProfileBtn').onclick=()=>openSheet('editProfileSheet');$('pickProfilePhoto').onclick=()=>profileInput.click();
$('addAccountBtn').onclick=()=>{$('accountServiceInput').value='';$('accountValueInput').value='';openSheet('accountSheet')};
$('saveAccountBtn').onclick=()=>{const service=$('accountServiceInput').value.trim(),value=$('accountValueInput').value.trim();if(!service||!value){toastMsg('Enter both fields');return}profile.accounts.push({service,value});saveProfile();logActivity('account','Added account',service+' • '+value);closeSheets();toastMsg('Account added')};
profileInput.onchange=()=>{const f=profileInput.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{profile.picture=r.result;saveProfile()};r.readAsDataURL(f)};
$('saveProfileBtn').onclick=()=>{profile.name=nameInput.value.trim()||'CornBox User';profile.handle=handleInput.value.trim()||'@cornbox';profile.bio=bioInput.value.trim();saveProfile();logActivity('profile','Updated profile',profile.name);closeSheets();toastMsg('Profile saved')};
$('resetLikesBtn').onclick=()=>{liked={};logActivity('settings','Cleared all likes');renderFeed();renderLibrary();updateStats();toastMsg('Likes cleared')};
updateProfileUI();renderFeed();renderLibrary();if(IS_NATIVE_IOS)postNative('listMedia');
</script>
</body>
</html>
